<div class="box">
	<div class="box-header">
		<h3 class="box-title">
			<%= title %> in :
		</h3>
		<select ng-model="selectedCountry">
			<option ng-repeat="country in countries" ng-value="country.id" ng-selected="country.id == selectedCountry">
				{{ country.enName }}</option
			>
		</select>
	</div>
	<!-- /.box-header -->
	<div class="box-body">
		<div class="overlay" ng-show="loading == true">
			<i class="fa fa-refresh fa-spin"></i>
		</div>
		<div class="box-body table-responsive no-padding" ng-show="loading == false">
			<table id="citiesTable" class="table table-bordered table-striped">
				<thead>
					<tr>
						<th>Iata Code</th>
						<th>En Name</th>
						<th>Ar Name</th>
						<th>En Description</th>
						<th>Ar Description</th>
						<th>Thumbnail</th>
						<th>Latitude</th>
						<th>Longitude</th>
						<th>Visit Order</th>
						<th>Active</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					<tr ng-repeat="city in cities">
						<td>{{ city.iataCode }}</td>
						<td>{{ city.enName }}</td>
						<td>{{ city.arName }}</td>
						<td>{{ city.enDescription }}</td>
						<td>{{ city.arDescription }}</td>
						<td>{{ city.thumbnail }}</td>
						<td>{{ city.lat }}</td>
						<td>{{ city.lng }}</td>
						<td>{{ city.visitOrder }}</td>
						<td>{{ city.active }}</td>
						<td>
							<i class="fa fa-edit cursor" ng-click="openEditDialog(city.id)"> Edit</i>
						</td>
					</tr>
				</tbody>
				<tfooter>
					<tr>
						<td colspan="12">
							<button
								type="button"
								class="btn btn-primary pull-right"
								data-toggle="modal"
								data-target="addCityModal"
								ng-click="openAddDialog()"
							>
								Add City
							</button>
						</td>
					</tr>
				</tfooter>
			</table>
		</div>
	</div>
	<!-- /.box-body -->
</div>
<!-- /.box -->
<!-- Main row -->
<div class="row">
	<!-- MODALS -->

	<div
		class="modal fade"
		id="addCityModal"
		tabindex="-1"
		role="dialog"
		aria-labelledby="myModalLabel"
		aria-hidden="true"
	>
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<button type="button" class="close" data-dismiss="modal" aria-label="Close">
						<span aria-hidden="true">&times;</span>
					</button>
					<h4 class="modal-title" id="myModalLabel">Add or Modify City</h4>
				</div>
				<div class="modal-body">
					<div class="callout callout-danger" ng-show="serverError==true">
						<h4>Saving failed!</h4>
						<p>{{ serverErrorMessage }}</p>
					</div>
					{{ newCity }}
					<form role="form" id="newCityForm">
						<div class="box-body">
							<div class="overlay" ng-show="saving == true">
								<i class="fa fa-refresh fa-spin"></i>
							</div>
							<div class="nav-tabs-custom">
								<ul class="nav nav-tabs">
									<li class="active">
										<a href="#basicTab" data-toggle="tab">Basic</a>
									</li>
									<li>
										<a href="#dailySpending" data-toggle="tab">Daily Spending</a>
									</li>
								</ul>
								<div class="tab-content">
									<div class="tab-pane active" id="basicTab">
										<div class="form-group-3" ng-show="saving==false">
											<label class="control-label text-red" for="enName" ng-show="enNameMissing==true">
												<i class="fa fa-times-circle-o"></i>English Name is missing</label
											>
											<label for="enName" ng-show="enNameMissing==false">En Name</label>
											<input
												type="text"
												required
												class="form-control"
												id="enName"
												ng-model="newCity.enName"
												placeholder="Enter name in English"
												required
											/>
										</div>
										<div class="form-group-9" ng-show="saving==false">
											<label class="control-label text-red" for="enDescription" ng-show="enDescriptionMissing==true">
												<i class="fa fa-times-circle-o"></i>English Description is missing</label
											>
											<label for="enDescription" ng-show="enDescriptionMissing==false">En Desc</label>
											<input
												type="text"
												required
												class="form-control"
												id="enDescription"
												ng-model="newCity.enDescription"
												placeholder="Enter description in English"
												required
											/>
										</div>
										<div class="form-group-3" ng-show="saving==false">
											<label class="control-label text-red" for="arName" ng-show="arNameMissing==true">
												<i class="fa fa-times-circle-o"></i>Arabic Name is missing</label
											>
											<label for="arName" ng-show="arNameMissing==false">Ar Name</label>
											<input
												type="text"
												required
												class="form-control"
												id="arName"
												ng-model="newCity.arName"
												placeholder="Enter name in Arabic"
												required
											/>
										</div>
										<div class="form-group-9" ng-show="saving==false">
											<label class="control-label text-red" for="arDescription" ng-show="arDescriptionMissing==true">
												<i class="fa fa-times-circle-o"></i>Arabic Description is missing</label
											>
											<label for="arDescription" ng-show="arDescriptionMissing==false">Ar Desc</label>
											<input
												type="text"
												required
												class="form-control"
												id="arDescription"
												ng-model="newCity.arDescription"
												placeholder="Enter description in Arabic"
												required
											/>
										</div>
										<div class="form-group-6" ng-show="saving==false">
											<label class="control-label text-red" for="iataCode" ng-show="iataCodeMissing==true">
												<i class="fa fa-times-circle-o"></i>Iata Code is missing</label
											>
											<label for="iataCode" ng-show="iataCodeMissing==false">Iata Code</label>
											<input
												type="text"
												class="form-control"
												id="iataCode"
												ng-model="newCity.iataCode"
												placeholder="Iata Code"
												required
											/>
										</div>
										<div class="form-group-6" ng-show="saving==false">
											<label class="control-label text-red" for="country" ng-show="countryIdMissing==true">
												<i class="fa fa-times-circle-o"></i>Country is missing</label
											>
											<label for="country" ng-show="countryIdMissing==false">countryId</label>
											<select disabled class="form-control" id="country" ng-model="newCity.countryId">
												<option
													ng-repeat="country in countries"
													ng-value="country.id"
													ng-selected="newCity.countryId == country.id"
												>
													{{ country.enName }}</option
												>
											</select>
										</div>
										<div class="form-group" ng-show="saving==false">
											<label class="control-label text-red" for="thumbnail" ng-show="thumbnailMissing==true">
												<i class="fa fa-times-circle-o"></i>Thumbnail is missing</label
											>
											<label for="thumbnail" ng-show="thumbnailMissing==false">Thumbnail</label>
											<input
												type="text"
												required
												class="form-control"
												id="thumbnail"
												ng-model="newCity.thumbnail"
												placeholder="Enter thumbnail"
												required
											/>
										</div>
										<div class="form-group-6" ng-show="saving==false">
											<label class="control-label text-red" for="lat" ng-show="latMissing==true">
												<i class="fa fa-times-circle-o"></i>Latitude is missing</label
											>
											<label for="lat" ng-show="latMissing==false">Latitude</label>
											<input
												type="text"
												required
												class="form-control"
												id="lat"
												ng-model="newCity.lat"
												placeholder="Enter latitude"
												required
											/>
										</div>
										<div class="form-group-6" ng-show="saving==false">
											<label class="control-label text-red" for="lng" ng-show="lngMissing==true">
												<i class="fa fa-times-circle-o"></i>Longitude is missing</label
											>
											<label for="lng" ng-show="lngMissing==false">Longitude</label>
											<input
												type="text"
												required
												class="form-control"
												id="lng"
												ng-model="newCity.lng"
												placeholder="Enter longitude"
												required
											/>
										</div>

										<div class="form-group-6" ng-show="saving==false">
											<label class="control-label text-red" for="visitOrder" ng-show="visitOrderMissing==true">
												<i class="fa fa-times-circle-o"></i>Visit order is missing</label
											>
											<label for="visitOrder" ng-show="visitOrderMissing==false">Visit order</label>
											<input
												type="text"
												class="form-control"
												id="visitOrder"
												ng-model="newCity.visitOrder"
												placeholder="Enter visit order"
												required
											/>
										</div>
										<div class="form-group-6" ng-show="saving==false">
											<label class="control-label text-red" for="active" ng-show="activeMissing==true">
												<i class="fa fa-times-circle-o"></i>Active is missing</label
											>
											<label for="active" ng-show="activeMissing==false">Active</label>
											<input type="text" class="form-control" id="active" ng-model="newCity.active" required />
										</div>
									</div>
									<!-- /.tab-pane -->
									<div class="tab-pane" id="dailySpending">
										<div
											class="form-group"
											ng-if="budgetCategory.id !== 1"
											ng-repeat="budgetCategory in budgetCategories"
											ng-show="saving==false"
										>
											<label for="{{ budgetCategory.id }}">{{ budgetCategory.en_name }}</label>
											<input
												class="form-control"
												id="{{ budgetCategory.id }}"
												ng-model="newCity.dailySpending[budgetCategory.id]"
												placeholder="Enter Daily Spending for {{ budgetCategory.en_name }}"
												required
											/>
										</div>
										<!-- /.form group -->
									</div>
								</div>
								<!-- /.tab-content -->
							</div>
							<!-- /.form group -->
						</div>
						<!-- /.box-body -->
					</form>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-default pull-left" data-dismiss="modal">Cancel</button>
					<button type="button" class="btn btn-primary" ng-click="addCity(true)" ng-show="editMode==false">
						Save and close
					</button>
					<button type="button" class="btn btn-primary" ng-click="addCity(false)" ng-show="editMode==false">
						Save and add another
					</button>
					<button type="button" class="btn btn-primary" ng-click="editCity()" ng-show="editMode==true">Save</button>
				</div>
			</div>
		</div>
	</div>
	<!-- MODALS END -->
</div>

<div class="box">
	<div class="box-header">
		<h3 class="box-title">
			<%= title %>
		</h3>
	</div>
	<!-- /.box-header -->
	<div class="box-body">
		<div class="overlay" ng-show="loading == true">
			<i class="fa fa-refresh fa-spin"></i>
		</div>		
		<div class="box-body table-responsive no-padding" ng-show="loading == false">
			<table id="countriesTable" class="table table-bordered table-striped">
				<thead>
					<tr>
						<th>En Name</th>
						<th>Ar Name</th>
						<th>ISO Code</th>
						<th>En Description</th>
						<th>Ar Description</th>
						<th>Active</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					<tr ng-repeat="country in countries">
						<td>
							<a ng-click="openEditDialog(country.id)" href="#">{{ country.enName }}</a>
						</td>
						<td>{{ country.arName }}</td>
						<td>{{ country.ISOCode }}</td>
						<td>{{ country.enDescription }}</td>
						<td>{{ country.arDescription }}</td>
						<td><a ng-show="country.active == 1" href="#" ng-click="deactivate(country.id)">Deactivate</a>
							<a ng-show="country.active == 0" href="#" ng-click="activate(country.id)">Activate</a>
						</td>
						<td>
							<i class="fa fa-edit cursor" ng-click="openEditDialog(country.id)"> Edit</i>
						</td>
					</tr>
				</tbody>
				<tfooter>
					<tr>
						<td colspan="10">
							<button
								type="button"
								class="btn btn-primary pull-right"
								data-toggle="modal"
								data-target="addCountryModal"
								ng-click="openAddDialog()"
							>
								Add Country
							</button>
						</td>
					</tr>
				</tfooter>
			</table>
		</div>
	</div>
	<!-- /.box-body -->
</div>
<!-- /.box -->
<!-- Main row -->
<div class="row">
	<!-- MODALS -->

	<div
		class="modal fade"
		id="addCountryModal"
		tabindex="-1"
		role="dialog"
		aria-labelledby="myModalLabel"
		aria-hidden="true"
	>
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<button type="button" class="close" data-dismiss="modal" aria-label="Close">
						<span aria-hidden="true">&times;</span>
					</button>
					<h4 class="modal-title" id="myModalLabel">Add or Modify Country</h4>
				</div>
				<div class="modal-body">
					<div class="callout callout-danger" ng-show="serverError==true">
						<h4>Saving failed!</h4>
						<p>{{ serverErrorMessage }}</p>
					</div>					
					<form role="form" id="newCountryForm">
						<div class="box-body">
							<div class="overlay" ng-show="saving == true">
								<i class="fa fa-refresh fa-spin"></i>
							</div>
							<div class="form-group-3" ng-show="saving==false">
								<label class="control-label text-red" for="enName" ng-show="enNameMissing==true">
									<i class="fa fa-times-circle-o"></i>English Name is missing</label
								>
								<label for="enName" ng-show="enNameMissing==false">En Name</label>
								<input
									type="text"
									required
									class="form-control"
									id="enName"
									ng-model="newCountry.enName"
									placeholder="Enter name in English"
									required
								/>
							</div>
							<div class="form-group-9" ng-show="saving==false">
								<label class="control-label text-red" for="enDescription" ng-show="enDescriptionMissing==true">
									<i class="fa fa-times-circle-o"></i>English Description is missing</label
								>
								<label for="enDescription" ng-show="enDescriptionMissing==false">En Desc</label>
								<input
									type="text"
									required
									class="form-control"
									id="enDescription"
									ng-model="newCountry.enDescription"
									placeholder="Enter description in English"
									required
								/>
							</div>
							<div class="form-group-3" ng-show="saving==false">
								<label class="control-label text-red" for="arName" ng-show="arNameMissing==true">
									<i class="fa fa-times-circle-o"></i>Arabic Name is missing</label
								>
								<label for="arName" ng-show="arNameMissing==false">Ar Name</label>
								<input
									type="text"
									required
									class="form-control"
									id="arName"
									ng-model="newCountry.arName"
									placeholder="Enter name in Arabic"
									required
								/>
							</div>
							<div class="form-group-9" ng-show="saving==false">
								<label class="control-label text-red" for="arDescription" ng-show="arDescriptionMissing==true">
									<i class="fa fa-times-circle-o"></i>Arabic Description is missing</label
								>
								<label for="arDescription" ng-show="arDescriptionMissing==false">Ar Desc</label>
								<input
									type="text"
									required
									class="form-control"
									id="arDescription"
									ng-model="newCountry.arDescription"
									placeholder="Enter description in Arabic"
									required
								/>
							</div>
							<div class="form-group" ng-show="saving==false">
								<label class="control-label text-red" for="introduction" ng-show="introductionMissing==true">
									<i class="fa fa-times-circle-o"></i>Introduction is missing</label
								>
								<label for="introduction" ng-show="introductionMissing==false">Introduction</label>
								<textarea
									class="form-control"
									id="introduction"
									ng-model="newCountry.introduction"
									placeholder="Enter introduction"
									rows="2"
								></textarea>
							</div>
							<div class="form-group" ng-show="saving==false">
								<label class="control-label text-red" for="includes" ng-show="includesMissing==true">
									<i class="fa fa-times-circle-o"></i>Includes is missing</label
								>
								<label for="includes" ng-show="includesMissing==false">Includes</label>
								<textarea
									bullet
									class="form-control"
									id="includes"
									ng-model="newCountry.includes"
									placeholder="Enter includes"
									rows="2"
								></textarea>
							</div>
							<div class="form-group" ng-show="saving==false">
								<label class="control-label text-red" for="excludes" ng-show="excludesMissing==true">
									<i class="fa fa-times-circle-o"></i>Excludes is missing</label
								>
								<label for="excludes" ng-show="excludesMissing==false">Excludes</label>
								<textarea
									bullet
									class="form-control"
									id="excludes"
									ng-model="newCountry.excludes"
									placeholder="Enter excludes"
									rows="2"
								></textarea>
							</div>
							<div class="form-group form-group-4" ng-show="saving==false">
								<label class="control-label text-red" for="visaType" ng-show="visaTypeMissing==true">
									<i class="fa fa-times-circle-o"></i>Visa type is missing</label
								>
								<label for="visaType" ng-show="visaTypeMissing==false">Visa type</label>
								<select class="form-control" ng-model="newCountry.visaType">
									<option value="0" ng-selected="true">No visa required</option>
									<option value="1">Online visa</option>
									<option value="2">Visa required</option>
								</select>
							</div>
							<div class="form-group" ng-show="saving==false">
								<label class="control-label text-red" for="visaRequirements" ng-show="visaRequirementsMissing==true">
									<i class="fa fa-times-circle-o"></i>Visa requirements is missing</label
								>
								<label for="visaRequirements" ng-show="visaRequirementsMissing==false">Visa requirements</label>
								<textarea
									bullet
									class="form-control"
									id="visaRequirements"
									ng-model="newCountry.visaRequirements"
									placeholder="Enter visa requirements"
									rows="2"
								></textarea>
							</div>
							<div class="form-group" ng-show="saving==false">
								<label class="control-label text-red" for="ISOCode" ng-show="ISOCodeMissing==true">
									<i class="fa fa-times-circle-o"></i>ISO Code is missing or is not a 3-letters text</label
								>
								<label for="ISOCode" ng-show="ISOCodeMissing==false">ISO Code</label>
								<input
									type="text"
									class="form-control"
									id="ISOCode"
									ng-model="newCountry.ISOCode"
									placeholder="Enter ISO Code"
									required
								/>
							</div>
							<div class="form-group-6" ng-show="saving==false">
								<label class="control-label text-red" for="thumbnail" ng-show="thumbnailMissing==true">
									<i class="fa fa-times-circle-o"></i>Thumbnail is missing</label
								>
								<label for="thumbnail" ng-show="thumbnailMissing==false">Thumbnail (rectangle 4/3 aspect-ratio PNG photo, around 800 X 600 pixels)</label>
								<!-- <input
									type="text"
									required
									class="form-control"
									id="thumbnail"
									ng-model="newCountry.thumbnail"
									placeholder="Enter thumbnail"
									required
								/> -->
								<style>
									input[type="file"] {
										display: none;
									}
									.custom-file-upload {
										border: 1px solid #ccc;
										display: inline-block;
										padding: 6px 12px;
										cursor: pointer;
									}
								</style>
								<label for="file-upload" class="custom-file-upload">
									<i class="fa fa-cloud-upload"></i> Choose Image
								</label>
								<input id="file-upload" type="file" fileread="newCountry.thumbnail" />
							</div>
							<div class="form-group-6" ng-show="saving==false">
								<img alt="No image available!" src="{{newCountry.thumbnail}}" style="width: 100px; height: 100px;"/>
							</div>
							<!-- /.form group -->
						</div>
						<!-- /.box-body -->
					</form>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-default pull-left" data-dismiss="modal">Cancel</button>
					<button type="button" class="btn btn-primary" ng-click="addCountry(true)" ng-show="editMode==false">
						Save and close
					</button>
					<button type="button" class="btn btn-primary" ng-click="addCountry(false)" ng-show="editMode==false">
						Save and add another
					</button>
					<button type="button" class="btn btn-primary" ng-click="editCountry()" ng-show="editMode==true">Save</button>
				</div>
			</div>
		</div>
	</div>
	<!-- MODALS END -->
</div>

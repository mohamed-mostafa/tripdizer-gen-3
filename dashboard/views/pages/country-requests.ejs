<div class="box">
	<div class="box-header">
		<h3 class="box-title">
            <%= title %>
		</h3>
	</div>
	<!-- /.box-header -->
	<div class="box-body">
		<div class="overlay" ng-show="loading == true">
			<i class="fa fa-refresh fa-spin"></i>
		</div>
		<div class="box-body table-responsive no-padding" ng-show="loading == false">
			<table id="countryRequestsTable" class="table table-bordered table-striped">
				<thead>
					<tr>
						<th>ID</th>
                        <th>Country</th>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Email</th>
						<th>Date</th>
						<th>Call Status</th>
					</tr>
				</thead>
				<tbody>
					<tr ng-repeat="request in CountryRequests">
						<td>{{ request.Id }}</td>
                        <td>{{ request.COUNTRY }}</td>
                        <td>{{ request.NAME }}</td>
                        <td>{{ request.Phone_Number }}</td>
                        <td>{{ request.EMAIL }}</td>
                        <td>{{ request.Date | date: 'dd/MM/yyyy' }}</td>
						<td><textarea name="request_country_status" id="request_country_status" class="form-control" rows="2" ng-model="request_country_status.Status" ng-blur="saveCountryRequestStatus(request.Id)"></textarea></td>
					</tr>
				</tbody>

			</table>
		</div>
	</div>
	<!-- /.box-body -->
</div>
<!-- /.box -->
<!-- Main row -->
</div>
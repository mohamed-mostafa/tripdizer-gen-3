<div class="box">
	<div class="box-header">
		<h3 class="box-title">
			<%= title %>
		</h3>
	</div>
	<!-- /.box-header -->
	<div class="box-body">
		<div class="overlay" ng-show="loading == true">
			<i class="fa fa-refresh fa-spin"></i>
		</div>
		<div class="box-body table-responsive no-padding" ng-show="loading == false">
			<textarea class="form-control" ng-model="emails" rows="25"></textarea>
		</div>
	</div>
	<!-- /.box-body -->
</div>
<!-- /.box -->
<!-- Main row -->
</div>
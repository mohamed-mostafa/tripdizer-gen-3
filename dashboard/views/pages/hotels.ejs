<div class="box">
	<div class="box-header">
		<h3 class="box-title">
			<%= title %> in :
		</h3>
		<select ng-model="selectedCountry">
			<option ng-repeat="country in countries" ng-value="country.id" ng-selected="country.id == selectedCountry">
				{{ country.enName }}</option
			>
		</select>

		<select ng-model="selectedCity">
			<option ng-repeat="city in cities" ng-value="city.id" ng-selected="city.id == selectedCity">
				{{ city.enName }}</option
			>
		</select>
	</div>
	<!-- /.box-header -->
	<div class="box-body">
		<div class="alert alert-warning" ng-show="dataEntryValid == false">
			<h4><i class="icon fa fa-warning"></i> Alert!</h4>
			Data entry is not complete! There should be at least <b>3 active hotels per budget category</b> for the selected city
		</div>
		<div class="overlay" ng-show="loading == true">
			<i class="fa fa-refresh fa-spin"></i>
		</div>
		<div class="box-body table-responsive no-padding" ng-show="loading == false">
			<table id="hotelsTable" class="table table-bordered table-striped">
				<thead>
					<tr>
						<th>En Name</th>
						<th>Ar Name</th>
						<th>En Description</th>
						<th>Ar Description</th>
						<th>Stars</th>
						<th>Budget Category</th>
						<th>Address</th>
						<th>Active</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					<tr ng-repeat="hotel in hotels">
						<td>{{ hotel.enName }}</td>
						<td>{{ hotel.arName }}</td>
						<td>{{ hotel.enDescription }}</td>
						<td>{{ hotel.arDescription }}</td>
						<td>{{ hotel.stars }}</td>
						<td>{{ hotel.budgetCategoryName }}</td>
						<td>{{ hotel.address }}</td>
						<td><a ng-show="hotel.active == 1" href="#" ng-click="deactivate(hotel.id)">Deactivate</a>
							<a ng-show="hotel.active == 0" href="#" ng-click="activate(hotel.id)">Activate</a>
						</td>
						<td>
							<i class="fa fa-edit cursor" ng-click="openEditDialog(hotel.id)"> Edit</i>
						</td>
					</tr>
				</tbody>
				<tfooter>
					<tr>
						<td colspan="12">
							<button
								type="button"
								class="btn btn-primary pull-right"
								data-toggle="modal"
								data-target="addHotelModal"
								ng-click="openAddDialog()"
							>
								Add Hotel
							</button>
						</td>
					</tr>
				</tfooter>
			</table>
		</div>
	</div>
	<!-- /.box-body -->
</div>
<!-- /.box -->
<!-- Main row -->
<div class="row">
	<!-- MODALS -->

	<div
		class="modal fade"
		id="addHotelModal"
		tabindex="-1"
		role="dialog"
		aria-labelledby="myModalLabel"
		aria-hidden="true"
	>
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<button type="button" class="close" data-dismiss="modal" aria-label="Close">
						<span aria-hidden="true">&times;</span>
					</button>
					<h4 class="modal-title" id="myModalLabel">Add or Modify Hotel</h4>
				</div>
				<div class="modal-body">
					<div class="callout callout-danger" ng-show="serverError==true">
						<h4>Saving failed!</h4>
						<p>{{ serverErrorMessage }}</p>
					</div>
					<div class="overlay" ng-show="saving == true">
						<i class="fa fa-refresh fa-spin"></i>
					</div>
					<form role="form" id="newHotelForm">
						<div class="box-body">
							<div class="overlay" ng-show="saving == true">
								<i class="fa fa-refresh fa-spin"></i>
							</div>
							<label class="control-label text-red" for="enName" ng-show="ratesIncomplete==true">
								<i class="fa fa-times-circle-o"></i>Rates data is incomplete or incorrect
							</label>
							<div class="nav-tabs-custom">
								<ul class="nav nav-tabs">
									<li class="active">
										<a href="#basicTab" data-toggle="tab">Basic</a>
									</li>
									<li>
										<a href="#ratesTab" data-toggle="tab">Rates</a>
									</li>
								</ul>
								<div class="tab-content">
									<div class="tab-pane active" id="basicTab">
										<div class="form-group-3" ng-show="saving==false">
											<label class="control-label text-red" for="enName" ng-show="enNameMissing==true">
												<i class="fa fa-times-circle-o"></i>English Name is missing</label>
											<label for="enName" ng-show="enNameMissing==false">En Name</label>
											<input
												type="text"
												required
												class="form-control"
												id="enName"
												ng-model="newHotel.enName"
												placeholder="Enter name in English"
												required/>
										</div>
										<div class="form-group-9" ng-show="saving==false">
											<label class="control-label text-red" for="enDescription" ng-show="enDescriptionMissing==true">
												<i class="fa fa-times-circle-o"></i>English Description is missing</label>
											<label for="enDescription" ng-show="enDescriptionMissing==false">En Desc</label>
											<input
												type="text"
												required
												class="form-control"
												id="enDescription"
												ng-model="newHotel.enDescription"
												placeholder="Enter description in English"
												required/>
										</div>
										<div class="form-group-3" ng-show="saving==false">
											<label class="control-label text-red" for="arName" ng-show="arNameMissing==true">
												<i class="fa fa-times-circle-o"></i>Arabic Name is missing</label>
											<label for="arName" ng-show="arNameMissing==false">Ar Name</label>
											<input
												type="text"
												required
												class="form-control"
												id="arName"
												ng-model="newHotel.arName"
												placeholder="Enter name in Arabic"
												required/>
										</div>
										<div class="form-group-9" ng-show="saving==false">
											<label class="control-label text-red" for="arDescription" ng-show="arDescriptionMissing==true">
												<i class="fa fa-times-circle-o"></i>Arabic Description is missing</label>
											<label for="arDescription" ng-show="arDescriptionMissing==false">Ar Desc</label>
											<input
												type="text"
												required
												class="form-control"
												id="arDescription"
												ng-model="newHotel.arDescription"
												placeholder="Enter description in Arabic"
												required/>
										</div>
										<div class="form-group-6" ng-show="saving==false">
											<label class="control-label text-red" for="city" ng-show="cityIdMissing==true">
												<i class="fa fa-times-circle-o"></i>City is missing</label>
											<label for="city" ng-show="cityIdMissing==false">City</label>
											<select class="form-control" id="city" ng-model="newHotel.cityId">
												<option ng-repeat="city in cities" ng-value="city.id" ng-selected="newHotel.cityId == city.id">
													{{ city.enName }}</option>
											</select>
										</div>
										<div class="form-group-6" ng-show="saving==false">
											<label class="control-label text-red" for="budgetCategory" ng-show="budgetCategoryMissing==true">
												<i class="fa fa-times-circle-o"></i>Budget Category is missing</label>
											<label for="budgetCategory" ng-show="budgetCategoryMissing==false">Budget Category</label>
											<select class="form-control" id="budgetCategory" ng-model="newHotel.budgetCategoryId">
												<option
													ng-repeat="budgetCategory in budgetCategories"
													ng-value="budgetCategory.id"
													ng-selected="newHotel.budgetCategoryId == budgetCategory.id">
													{{ budgetCategory.en_name }}</option>
											</select>
										</div>
										<div class="form-group" ng-show="saving==false">
											<label class="control-label text-red" for="thumbnail" ng-show="thumbnailMissing==true">
												<i class="fa fa-times-circle-o"></i>Thumbnail is missing</label>
											<label for="thumbnail" ng-show="thumbnailMissing==false">Thumbnail (square PNG photo, maximum 100 X 100 pixels)</label>
											<!-- <input
												type="url"
												required
												class="form-control"
												id="thumbnail"
												ng-model="newHotel.file.name"
												placeholder="Enter thumbnail"
												required disabled/> -->
												<input type="file" fileread="newHotel.thumbnail" />
										</div>
										<div class="form-group-6" ng-show="saving==false">
											<label class="control-label text-red" for="stars" ng-show="starsMissing==true">
												<i class="fa fa-times-circle-o"></i>Stars is missing or has an incorrect value</label>
											<label for="stars" ng-show="starsMissing==false">Stars</label>
											<input
												type="number"
												class="form-control"
												id="stars"
												ng-model="newHotel.stars"
												placeholder="Enter stars (1, 2, 3, 4 or 5)"
												required
												min="1"
												max="5"/>
										</div>
										<div class="form-group-6" ng-show="saving==false">
											<label class="control-label text-red" for="stars" ng-show="addressMissing==true">
												<i class="fa fa-times-circle-o"></i>Address is missing</label>
											<label for="stars" ng-show="starsMissing==false">Address</label>
											<input
												type="text"
												class="form-control"
												id="address"
												ng-model="newHotel.address"
												placeholder="Enter Address"
												required/>
										</div>
									</div>
									<div class="tab-pane" id="ratesTab">
										<div class="form-control-3">
											<label>Jan:</label>
											<input class="form-control" type="number" ng-model="newHotel.rates.JAN" required>
										</div>
										<div class="form-control-3">
											<label>Feb:</label>
											<input class="form-control" type="number" ng-model="newHotel.rates.FEB" required >
										</div>
										<div class="form-control-3">
											<label>Mar:</label>
											<input class="form-control" type="number" ng-model="newHotel.rates.MAR" required >
										</div>
										<div class="form-control-3">
											<label>Apr:</label>
											<input class="form-control" type="number" ng-model="newHotel.rates.APR" required >
										</div>
										<div class="form-control-3">
											<label>May:</label>
											<input class="form-control" type="number" ng-model="newHotel.rates.MAY" required >
										</div>
										<div class="form-control-3">
											<label>Jun:</label>
											<input class="form-control" type="number" ng-model="newHotel.rates.JUN" required >
										</div>
										<div class="form-control-3">
											<label>Jul:</label>
											<input class="form-control" type="number" ng-model="newHotel.rates.JUL" required >
										</div>
										<div class="form-control-3">
											<label>Aug:</label>
											<input class="form-control" type="number" ng-model="newHotel.rates.AUG" required >
										</div>
										<div class="form-control-3">
											<label>Sept:</label>
											<input class="form-control" type="number" ng-model="newHotel.rates.SEP" required >
										</div>
										<div class="form-control-3">
											<label>Oct:</label>
											<input class="form-control" type="number" ng-model="newHotel.rates.OCT" required >
										</div>
										<div class="form-control-3">
											<label>Nov:</label>
											<input class="form-control" type="number" ng-model="newHotel.rates.NOV" required >
										</div>
										<div class="form-control-3">
											<label>Dec:</label>
											<input class="form-control" type="number" ng-model="newHotel.rates.DEC" required >
										</div>
									</div>
								</div>
							</div>
						</div>
					</form>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-default pull-left" data-dismiss="modal">Cancel</button>
					<button type="button" class="btn btn-primary" ng-click="addHotel(true)" ng-show="editMode==false">
						Save and close
					</button>
					<button type="button" class="btn btn-primary" ng-click="addHotel(false)" ng-show="editMode==false">
						Save and add another
					</button>
					<button type="button" class="btn btn-primary" ng-click="editHotel()" ng-show="editMode==true">Save</button>
				</div>
			</div>
		</div>
	</div>
	<!-- MODALS END -->
</div>

<form role="form" id="orderForm">
    <fieldset ng-disabled="loading" class="box-body">
        <div class="overlay" ng-show="loading == true">
            <i class="fa fa-refresh fa-spin"></i>
        </div>
        <div class="nav-tabs-custom">
            <ul class="nav nav-tabs">
                <li class="active">
                    <a href="#requestTab" data-toggle="tab">Request</a>
                </li>
                <li>
                    <a href="#travelerTab" data-toggle="tab">Traveler</a>
                </li>
                <li>
                    <a href="#datesTab" data-toggle="tab">Dates</a>
                </li>
                <li>
                    <a href="#destinationsTab" data-toggle="tab">Destinations</a>
                </li>
                <li>
                    <a href="#purposeTab" data-toggle="tab">Purpose</a>
                </li>
                <li>
                    <a href="#budgetTab" data-toggle="tab">Budget</a>
                </li>
                <li>
                    <a href="#interestsTab" data-toggle="tab">Interests</a>
                </li>
                <li>
                    <a href="#detailsTab" data-toggle="tab">Assistance</a>
                </li>
                <!-- <li ng-if="!isCreate">
                    <a href="#revenueTab" data-toggle="tab">Financial</a>
                </li> -->
                <li ng-if="currentOrder.flightOffers.choices">
                    <a href="#flightsTab" data-toggle="tab">Transportation</a>
                </li>
                <li ng-if="currentOrder.selectedHotels.choices">
                    <a href="#accomodationTab" data-toggle="tab">Accomodation</a>
                </li>
                <li ng-if="currentOrder.selectedAttractions.choices">
                    <a href="#attractionsTab" data-toggle="tab">Attractions</a>
                </li>
                <li ng-if="!isCreate && currentOrder.paymentInfo">
                    <a href="#paymentTab" data-toggle="tab">Payment</a>
                </li>
                <li ng-if="!isCreate && currentOrder.pnrInfo">
                    <a href="#pnrTab" data-toggle="tab">Passengers</a>
                </li>
                <li ng-if="!isCreate && currentOrder.destination">
                    <a href="#generatePackageTab" data-toggle="tab">Package</a>
                </li>
                <li ng-if="!isCreate">
                    <a href="#mailshistoryTab" data-toggle="tab">Mails History</a>
                </li>
            </ul>
            <div class="tab-content">
                <div class="tab-pane active" id="requestTab">
                    <div ng-if="!isCreate" class="form-control-6">
                        <label for="id">ID</label>
                        <input type="text" disabled class="form-control" id="id" ng-model="currentOrder.id">
                    </div>
                    <div ng-class="{ 'form-control-6' : !isCreate }">
                        <label for="status">Status</label>
                        <select class="form-control" id="status" ng-model="currentOrder.status">
                            <option ng-repeat="status in statuses" ng-value="status.id"
                                ng-selected="status.id == currentOrder.status">
                                {{status.title}}</option>
                        </select>
                    </div>
                    <div ng-if="!isCreate" class="form-control-6">
                        <label for="placed">Placed</label>
                        <input type="date" disabled class="form-control" id="placed" format="yyyy-MM-dd"
                            ng-model="currentOrder.date">
                    </div>
                    <div ng-if="!isCreate" class="form-control-6">
                        <label for="promoCode">Promo Code</label>
                        <input type="text" disabled class="form-control" id="promoCode"
                            ng-model="currentOrder.promoCode">
                    </div>
                    <div ng-if="!isCreate" class="form-control-6">
                        <label for="userFullName">Assigned User</label>
                        <input type="text" disabled class="form-control" id="userFullName"
                            ng-model="currentOrder.userFullName"></input>
                    </div>
                    <div ng-if="!isCreate" class="form-control-6">
                        <label for="score">Score</label>
                        <input type="text" disabled class="form-control" id="score"
                            ng-model="currentOrder.score"></input>
                    </div>
                    <div>
                        <label for="channel">Channel</label>
                        <select class="form-control" id="channel" ng-model="currentOrder.channel">
                            <option ng-repeat="channel in channels" ng-if="!channel.isHiddenOnDashboard"
                                ng-value="channel.id" ng-selected="channel.id == currentOrder.channel">
                                {{channel.enName}}</option>
                        </select>
                    </div>
                    <div>
                        <label for="specialRequests">Comments</label>
                        <textarea class="form-control" id="specialRequests"
                            ng-model="currentOrder.specialRequests"></textarea>
                    </div>
                </div>

                <!-- /.tab-pane -->
                <fieldset ng-disabled="!isCreate" class="tab-pane" id="travelerTab">
                    <div>
                        <label for="customer">Name</label>
                        <input type="text" class="form-control" id="customer" ng-model="currentOrder.traveler.name">
                    </div>
                    <div>
                        <label for="email">Email</label>
                        <input type="text" class="form-control" id="email"
                            ng-model="currentOrder.traveler.emailAddress">
                    </div>
                    <div class="form-control-6">
                        <label for="phone">Phone</label>
                        <input type="text" class="form-control" id="phone" ng-model="currentOrder.traveler.mobile">
                    </div>
                    <div class="form-control-6">
                        <label for="gender">Gender</label>
                        <select class="form-control" id="gender" ng-model="currentOrder.traveler.gender">
                            <option value="1">Male</option>
                            <option value="2">Female</option>
                        </select>
                    </div>
                    <div class="form-control-6">
                        <label for="dob">Date of birth</label>
                        <input type="date" class="form-control" id="dob" format="yyyy-MM-dd"
                            ng-model="currentOrder.traveler.dateOfBirth">
                    </div>
                    <div class="form-control-6">
                        <label for="profession">Profession</label>
                        <select class="form-control" id="profession" ng-model="currentOrder.traveler.profession">
                            <option ng-repeat="profession in professions" ng-value="profession.id"
                                ng-selected="profession.id === currentOrder.traveler.profession">
                                {{profession.enName}}
                            </option>
                        </select>
                    </div>
                    <div class="form-control-6">
                        <label for="referralType">Referral</label>
                        <select class="form-control" id="referralType" ng-model="currentOrder.referralType">
                            <option ng-repeat="type in referralTypes" ng-value="type.id"
                                ng-selected="type.id === currentOrder.referralType">{{type.enName}}</option>
                        </select>
                    </div>
                    <div class="form-control-6">
                        <label for="travelHistory">Travel History</label>
                        <select class="form-control" id="travelHistory" ng-model="currentOrder.travelHistory">
                            <option value="1">Traveled Before</option>
                            <option value="2">Never Traveled</option>
                        </select>
                    </div>
                </fieldset>
                <!-- /.tab-pane -->

                <div class="tab-pane" id="datesTab">

                    <div class="form-control-6">
                        <label for="departureDate">Departure Date</label>
                        <input type="date" class="form-control" id="departureDate" format="yyyy-MM-dd"
                            ng-model="currentOrder.departureDate">
                    </div>
                    <div class="form-control-6">
                        <label for="returnDate">Return Date</label>
                        <input type="date" class="form-control" id="returnDate" format="yyyy-MM-dd"
                            ng-model="currentOrder.returnDate">
                    </div>
                    <div class="form-control-6">
                        <label for="flexibleDates">Flexible Dates</label>
                        <select class="form-control" id="flexibleDates" ng-model="currentOrder.isFlexibleDates">
                            <option value="1" ng-selected="currentOrder.isFlexibleDates === 1">True</option>
                            <option value="0" ng-selected="currentOrder.isFlexibleDates !== 1">False</option>
                        </select>
                    </div>

                </div><!-- /.tab-pane -->
                <div class="tab-pane" id="destinationsTab">
                    <div class="form-control-6">
                        <label for="travelingFrom">Traveling From</label>
                        <select class="form-control" id="travelingFrom" ng-model="currentOrder.travelingFrom">
                            <option>Cairo</option>
                            <option>Alexandria</option>
                            <option>Hurghada</option>
                            <option>Sharm El-Sheikh</option>
                        </select>
                    </div>
                    <div ng-if="currentOrder.selectedCities.choices">
                        <label for="cities">Travelling to (cities)</label>
                        <div ng-repeat="city in currentOrder.selectedCities.choices">
                            <input type="checkbox" checked disabled>{{city.name}}</input>
                        </div>
                    </div>
                    <div ng-if="currentOrder.destination && !currentOrder.selectedCities.choices">
                        <label for="destination">Destination</label>
                        <select class="form-control" id="destination" ng-model="currentOrder.destination">
                            <option ng-repeat="itinerary in itineraries" ng-value="itinerary.id"
                                ng-selected="itinerary.id === currentOrder.destination">{{itinerary.en_name}}
                            </option>
                        </select>
                        <div ng-if="currentOrder.destination == '-1'">
                            <label for="otherCountry">Other Destination</label>
                            <input type="text" class="form-control" id="otherCountry"
                                ng-model="currentOrder.otherCountry">
                        </div>
                    </div>
                    <!-- <div ng-if="!currentOrder.destination && !currentOrder.selectedCites.choices">
                        <label for="firstCountry">First Country</label>
                        <select class="form-control" id="firstCountry" ng-model="currentOrder.firstCountry">
                            <option ng-repeat="country in countries" ng-value="country.id"
                                ng-selected="country.id === currentOrder.firstCountry">{{country.en_name}}</option>
                        </select>
                        <div ng-if="currentOrder.firstCountry == '1'">
                            <label for="otherCountry">Other Country</label>
                            <input type="text" class="form-control" id="otherCountry"
                                ng-model="currentOrder.otherCountry">
                        </div>
                        <div ng-if="currentOrder.secondCountry != 0">
                            <label for="secondCountry">Second Country</label>
                            <select class="form-control" id="secondCountry" ng-model="currentOrder.secondCountry">
                                <option ng-repeat="country in countries" ng-value="country.id"
                                    ng-selected="country.id === currentOrder.secondCountry">{{country.en_name}}
                                </option>
                            </select>
                        </div>
                        <div ng-if="currentOrder.thirdCountry != 0">
                            <label for="thirdCountry">Third Country</label>
                            <select class="form-control" id="thirdCountry" ng-model="currentOrder.thirdCountry">
                                <option ng-repeat="country in countries" ng-value="country.id"
                                    ng-selected="country.id === currentOrder.thirdCountry">{{country.en_name}}
                                </option>
                            </select>
                        </div>
                    </div> -->
                    <div ng-if="!isCreate && currentOrder.destination && !currentOrder.cities.choices">
                        <label for="actualDestination">Actual Destination</label>
                        <select class="form-control" id="actualDestination" ng-model="currentOrder.actualDestination">
                            <option value="">None</option>
                            <option ng-repeat="itinerary in itineraries" ng-value="itinerary.id"
                                ng-selected="itinerary.id === currentOrder.actualDestination">{{itinerary.en_name}}
                            </option>
                        </select>
                        <div ng-if="currentOrder.actualDestination == '-1'">
                            <label for="otherActualDestination">Other Actual Destination</label>
                            <input type="text" class="form-control" id="otherActualDestination"
                                ng-model="currentOrder.otherActualDestination">
                        </div>
                    </div>
                </div>
                <div class="tab-pane" id="purposeTab">
                    <div>
                        <label for="purpose">Travel Purpose</label>
                        <select class="form-control" id="purpose" ng-model="currentOrder.purpose">
                            <option ng-repeat="purpose in purposes" ng-value="purpose.id"
                                ng-selected="purpose.id === currentOrder.purpose">{{purpose.en_name}}</option>
                        </select>
                    </div>
                    <div ng-if="currentOrder.purpose == 1">
                        <label for="otherPurposeName">Other Purpose Name</label>
                        <input type="text" class="form-control" id="otherPurposeName"
                            ng-model="currentOrder.otherPurposeName">
                    </div>
                    <div class="form-control-4">
                        <label for="adultsNumber">Adults Number</label>
                        <input type="number" min="1" step="1" class="form-control" id="adultsNumber"
                            ng-model="currentOrder.adultsNumber">
                    </div>
                    <div class="form-control-4">
                        <label for="kidsNumber">Kids Number</label>
                        <input type="number" min="1" step="1" class="form-control" id="kidsNumber"
                            ng-model="currentOrder.kidsNumber">
                    </div>
                    <div class="form-control-4">
                        <label for="infantsNumber">Infants Number</label>
                        <input type="number" min="1" step="1" class="form-control" id="infantsNumber"
                            ng-model="currentOrder.infantsNumber">
                    </div>
                </div>
                <!-- /.tab-pane -->
                <div class="tab-pane" id="budgetTab">
                    <div>
                        <div>
                            <label for="budgetCategory">Budget Category</label>
                            <select class="form-control" id="budgetCategory" ng-model="currentOrder.budgetCategory">
                                <option ng-repeat="budget in budgetCategories" ng-value="budget.id"
                                    ng-selected="budget.id === currentOrder.budgetCategory">{{budget.en_name}}</option>
                            </select>
                        </div>
                        <div ng-if="currentOrder.budgetCategory == 1">
                            <label for="budget">Budget</label>
                            <input type="text" class="form-control" id="budget" ng-model="currentOrder.budget">
                        </div>
                        <div ng-if="!isCreate">
                            <label for="estimatedBudget">Estimated Budget</label>
                            <input type="number" disabled class="form-control" id="estimatedBudget"
                                ng-model="currentOrder.estimatedCost">
                        </div>
                    </div>
                </div>
                <!-- /.tab-pane -->
                <div class="tab-pane" id="interestsTab">
                    <div ng-if="isCreate">
                        <label class="form-control-6" ng-repeat="interest in interests">
                            <input type="checkbox" ng-model="currentOrder.preferences[interest.id]" />
                            {{ interest.en_name }}
                        </label>
                        <div ng-if="isOtherInterestName()">
                            <label for="otherInterestName">Other Interest Name</label>
                            <input type="text" class="form-control" id="otherInterestName"
                                ng-model="currentOrder.otherInterestName">
                        </div>
                    </div>
                    <table ng-if="!isCreate" class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th>Interest</th>
                                <th>Percentage</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="interest in currentOrder.interests"
                                ng-show="currentOrder.interests.length != 0">
                                <td>{{ interest.id == 0 ? currentOrder.otherInterestName : interests[interest.id - 1].en_name }}
                                </td>
                                <td>{{interest.percentage | number}}%</td>
                            </tr>
                        </tbody>
                    </table>
                    <div>
                    </div>
                </div>
                <!-- /.tab-pane -->
                <div class="tab-pane" id="detailsTab">
                    <div class="form-control-6">
                        <label for="visaAssistanceNeeded">Visa Assistance Needed</label>
                        <select class="form-control" id="visaAssistanceNeeded"
                            ng-model="currentOrder.visaAssistanceNeeded">
                            <option value="1" ng-selected="currentOrder.visaAssistanceNeeded === 1">True</option>
                            <option value="0" ng-selected="currentOrder.visaAssistanceNeeded === 0">False</option>
                        </select>
                    </div>
                    <div class="form-control-6">
                        <label for="tourGuideNeeded">Tour Guide Needed</label>
                        <select class="form-control" id="tourGuideNeeded" ng-model="currentOrder.tourGuideNeeded">
                            <option value="1" ng-selected="currentOrder.tourGuideNeeded === 1">True</option>
                            <option value="0" ng-selected="currentOrder.tourGuideNeeded === 0">False</option>
                        </select>
                    </div>
                </div>

                <!-- /.tab-pane -->
                <!-- <div ng-if="!isCreate" class="tab-pane" id="revenueTab">
                    <div class="form-control-6">
                        <label for="profit">Revenue</label>
                        <input type="number" min="0.00" step="1" class="form-control" id="revenue"
                            ng-model="currentOrder.revenue">
                    </div>
                    <div class="form-control-6">
                        <label for="profit">Profit</label>
                        <input type="number" min="0.00" step="1" class="form-control" id="profit"
                            ng-model="currentOrder.profit">
                    </div>
                </div> -->

                <div class="tab-pane" id="flightsTab">
                    <div ng-repeat="flightOffer in currentOrder.flightOffers.choices"
                        ng-show="currentOrder.flightOffers.choices.length != 0">
                        <!-- The folowing displays the new filght offer model: one flight offer containing all flight legs-->
                        <div ng-show="flightOffer.fareSourceCode != null">
                            <table>
                                <tbody ng-repeat="flightLeg in flightOffer.flightLegs">
                                    <tr>
                                        <th colspan="6">{{flightLeg.origin.name }} to {{flightLeg.destination.name}}
                                        </th>
                                    </tr>
                                    <tr>
                                        <th>From</th>
                                        <th>To</th>
                                        <th>Depart</th>
                                        <th>Arrive</th>
                                        <th>Duration</th>
                                        <th>Airline</th>
                                    </tr>
                                    <tr ng-repeat="segment in flightLeg.segments">
                                        <td>{{segment.origin }} ({{segment.originDetails}}) </td>
                                        <td>{{segment.destination }} ({{segment.destinationDetails}}) </td>
                                        <td>{{segment.departure | date:'dd MMM yyyy - hh:mm'}}</td>
                                        <td>{{segment.arrival | date:'dd MMM yyyy - hh:mm'}}</td>
                                        <td>{{segment.totalDurationInWords}}</td>
                                        <td>{{segment.carrier.name}}</td>
                                    </tr>
                                </tbody>
                                <tbody>
                                    <tr>
                                        <th colspan="6">Cost Details
                                        </th>
                                    </tr>
                                    <tr>
                                        <td>Price</td>
                                        <td>{{flightOffer.price}}</td>
                                        <td>Currency</td>
                                        <td>{{flightOffer.currency}}</td>
                                        <td>Fare Type</td>
                                        <td>{{flightOffer.fareType}}</td>
                                    </tr>
                                </tbody>
                                <tbody
                                    ng-show="flightOffer.bookingInfo.confirmation == null && flightOffer.bookingInfo.failure != null">
                                    <tr style="color: red">
                                        <th colspan="6">Booking failure reason
                                        </th>
                                    </tr>
                                    <tr>
                                        <td colspan="6">
                                            {{flightOffer.bookingInfo.failure.error ? flightOffer.bookingInfo.failure.error : flightOffer.bookingInfo.failure }}
                                        </td>
                                    </tr>
                                </tbody>
                                <tbody
                                    ng-show="flightOffer.bookingInfo.confirmation != null && flightOffer.bookingInfo.failure == null">
                                    <tr>
                                        <th colspan="6">Booking information
                                        </th>
                                    </tr>
                                    <tr>
                                        <td style="color: green">Booking Status</td>
                                        <td style="color: green">flightOffer.bookingInfo.confirmation.bookingStatus</td>
                                        <td>Confirmation Number</td>
                                        <td>flightOffer.bookingInfo.confirmation.confirmationNumbers</td>
                                        <td>Ticket Number</td>
                                        <td>flightOffer.bookingInfo.confirmation.referenceNumbers</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <!-- The folowing displays the legacy filght offer model: one flight offer per flight leg-->
                        <div ng-show="flightOffer.fareSourceCode == null">
                            <h4><img src="{{flightOffer.carrier.squareLogo}}" width="30px" height="30px" />
                                {{flightOffer.segments[0].origin}} to
                                {{flightOffer.segments[flightOffer.segments.length - 1].destination}} on
                                {{flightOffer.carrier.name}} </h4>
                            <div>
                                <div class="form-control-6">
                                    <p><b>Departure:
                                        </b>{{flightOffer.segments[0].departure | date:'dd MMM yyyy - hh:mm'}}
                                    </p>
                                </div>
                                <div class="form-control-6">
                                    <p><b>Arrival:
                                        </b>{{flightOffer.segments[flightOffer.segments.length - 1].return | date:'dd MMM yyyy - hh:mm'}}
                                    </p>
                                </div>
                            </div>
                            <div>
                                <div class="form-control-6">
                                    <p><b>Price: </b>{{flightOffer.price}} {{flightOffer.currency}}</p>
                                </div>
                                <div class="form-control-6">
                                    <p><b>Stops:
                                        </b>{{flightOffer.segments.length == 1 ? 'direct' : flightOffer.segments.length - 1 }}
                                    </p>
                                </div>
                            </div>
                            <div ng-repeat="segment in flightOffer.segments" ng-hide="flightOffer.segments.length == 1">
                                <p>{{segment.origin}}: {{segment.departure | date:'dd MMM yyyy - hh:mm'}} |
                                    {{segment.destination }}: {{segment.return | date:'dd MMM yyyy - hh:mm'}} |
                                    {{segment.durationInWords}}</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="tab-pane" id="accomodationTab">
                    <div ng-repeat="hotel in currentOrder.selectedHotels.choices"
                        ng-show="currentOrder.selectedHotels.choices.length != 0">
                        <h4>{{hotel.city}} ({{hotel.numberOfNights}} nights)</h4>
                        <div>
                            <div class="form-control-6">
                                <p><b>Hotel: </b>{{hotel.name}}</p>
                            </div>
                            <div class="form-control-6">
                                <p><b>Stars: </b>{{hotel.stars }}</p>
                            </div>
                        </div>
                        <div>
                            <div class="form-control-6">
                                <p><b>Checkin: </b>{{hotel.checkin | date:'dd MMM yyyy -hh:mm'}}</p>
                            </div>
                            <div class="form-control-6">
                                <p><b>Checkout: </b>{{hotel.checkout | date:'dd MMM yyyy'}}</p>
                            </div>
                        </div>
                        <div>
                            <div class="form-control-12">
                                <p><b>Total: </b>{{hotel.price }} {{hotel.currency}}</p>
                            </div>
                        </div>
                        <div ng-if="hotel.bookingInfo.confirmation != null && hotel.bookingInfo.failure == null">
                            <div class="form-control-12" style="color: green">
                                <p><b>Booking Status: </b>{{hotel.bookingInfo.confirmation.bookingStatus}}</p>
                            </div>
                            <div class="form-control-12">
                                <p><b>Room: </b>{{hotel.bookingInfo.confirmation.bookingDetails.room_name}}
                                    ({{hotel.bookingInfo.confirmation.bookingDetails.room_count}}
                                    rooms)</p>
                            </div>
                            <div class="form-control-12">
                                <p><b>Confirmation Number: </b>{{hotel.bookingInfo.confirmation.referenceNumbers}}</p>
                            </div>
                        </div>
                        <div ng-if="hotel.confirmation == null && hotel.failure != null">
                            <div class="form-control-6" style="color: red">
                                <p><b>Booking failure reason:
                                    </b>{{hotel.bookingInfo.failure.error ? hotel.bookingInfo.failure.error : hotel.bookingInfo.failure }}
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="tab-pane" id="attractionsTab">
                    <div ng-repeat="item in currentOrder.selectedAttractions.choices"
                        ng-show="currentOrder.selectedAttractions.choices.length != 0">
                        <h4>{{item.city.name}}</h4>
                        <div ng-repeat="attraction in item.attractions">
                            <input type="checkbox" disabled checked>{{attraction.name}}</input>
                        </div>
                    </div>
                </div>
                <div class="tab-pane" id="pnrTab">
                    <div ng-repeat="pnrInfo in currentOrder.pnrInfo.choices"
                        ng-show="currentOrder.pnrInfo.choices.length != 0">
                        <table>
                            <tr ng-repeat="(key, value) in pnrInfo"
                                style="border-width:1px; border-color: black; border-style: solid;">
                                <th> {{key}} </th>
                                <td> {{ value }} </td>
                            </tr>
                        </table>
                    </div>
                </div>
                <div class="tab-pane" id="paymentTab">
                    <div>
                        <table>
                            <tr>
                                <th>Amount</th>
                                <td>{{currentOrder.paymentInfo.obj.data.amount}}</td>
                            </tr>
                            <tr>
                                <th>Currency</th>
                                <td>{{currentOrder.paymentInfo.obj.data.currency}}</td>
                            </tr>
                            <tr>
                                <th>Time</th>
                                <td>{{currentOrder.paymentInfo.obj.data.created_at | date:'dd MMM yyyy -hh:mm'}}</td>
                            </tr>
                            <tr>
                                <th>Card #</th>
                                <td>{{currentOrder.paymentInfo.obj.data.card_num}}</td>
                            </tr>
                            <tr>
                                <th>Reciept #</th>
                                <td>{{currentOrder.paymentInfo.obj.data.receipt_no}}</td>
                            </tr>
                            <tr>
                                <th>Transaction #</th>
                                <td>{{currentOrder.paymentInfo.obj.data.transaction_no}}</td>
                            </tr>
                            <tr>
                                <th>Message</th>
                                <td>{{currentOrder.paymentInfo.obj.data.message}}</td>
                            </tr>
                        </table>
                    </div>
                </div>
                <!-- /.tab-pane -->
                <div ng-if="!isCreate" class="tab-pane" id="generatePackageTab">
                    <!-- <input type="text" class="form-control" id="packageName" ng-model="currentOrder.packageName" ng-change="currentOrder.generatedFile = null">
                                  <input type="text" class="form-control" id="destinationName" ng-model="currentOrder.destinationName" ng-change="currentOrder.generatedFile = null">
                                  <input type="text" class="form-control" id="introduction" ng-model="currentOrder.introduction" ng-change="currentOrder.generatedFile = null"> -->
                    <center>
                        <div ng-show="loading">
                            <i class="fa fa-refresh fa-spin"></i>
                        </div>
                        <button ng-if="!currentOrder.docUrl && !loading" ng-click="generatePackage()">Generate New
                            Package</button>
                        <a ng-if="currentOrder.docUrl && !loading" ng-href="{{currentOrder.docUrl}}"
                            target="_blank">Open Generated Document</a>
                        <br>
                        <a ng-if="currentOrder.pdfUrl && !loading" ng-href="{{currentOrder.pdfUrl}}"
                            target="_blank">Open Generated PDF</a>
                        <br>
                        <br>
                        <button ng-if="currentOrder.docUrl && !loading" ng-click="generatePackage()">Re-Generate New
                            Package</button>
                    </center>
                </div>

                <!-- /.tab-pane -->
                <div ng-if="!isCreate" class="tab-pane" id="mailshistoryTab">
                    <table class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Subject</th>
                                <th>Files</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="mail in currentOrder.mailsHistory"
                                ng-show="currentOrder.questionAnswers.length != 0">
                                <td>{{mail.date | date: 'MMM d, yyyy h:mma'}}</td>
                                <td ng-bind="mail.subject"></td>
                                <td>
                                    <ul>
                                        <li ng-repeat="attachment in mail.attachments">{{attachment}}</li>
                                    </ul>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- /.tab-content -->
        </div>
        <!-- nav-tabs-custom -->
    </fieldset>
    <!-- /.box-body -->
</form>